@@ -566,7 +574,30 @@ bool rgb_matrix_indicators_advanced_kb(uint8_t led_min, uint8_t led_max) {
         rgb_matrix_set_color(two_digit_ones_led(dev_info.rf_battery), 0x00, 0x80, 0x80);
     }
 
-    return rgb_matrix_indicators_advanced_user(led_min, led_max);
+    bool result = rgb_matrix_indicators_advanced_user(led_min, led_max);
+
+    if (host_indicator_active) {
+        uint8_t caps_led = get_led_index(3, 0);
+        uint8_t f8_led   = get_led_index(0, 8);
+        if (caps_led >= led_min && caps_led <= led_max) {
+            user_set_rgb_color(
+                caps_led,
+                host_indicator_color.r,
+                host_indicator_color.g,
+                host_indicator_color.b
+            );
+        }
+        if (host_indicator_music_playing && f8_led >= led_min && f8_led <= led_max) {
+            user_set_rgb_color(
+                f8_led,
+                host_indicator_color.r,
+                host_indicator_color.g,
+                host_indicator_color.b
+            );
+        }
+    }
+
+    return result;
 }
 
 /* qmk housekeeping task */
@@ -574,5 +665,7 @@ void housekeeping_task_kb(void) {
     timer_pro();
 
+    host_brightness_task();
+
 #if (WORK_MODE == THREE_MODE)
     uart_receive_pro();
 
@@ -733,6 +828,18 @@ void via_config_set_value(uint8_t *data)
         case id_toggle_socd_indicator:
             g_config.show_socd_indicator = *value_data;
             break;
+        case id_host_key_indicators:
+            host_indicator_color.r       = value_data[0];
+            host_indicator_color.g       = value_data[1];
+            host_indicator_color.b       = value_data[2];
+            host_indicator_music_playing = value_data[3] != 0;
+            host_indicator_active        = true;
+            break;
+        case id_host_backlight_brightness:
+            if (value_data[2] == HOST_BRIGHTNESS_PROTOCOL_MARKER) {
+                host_brightness_set_target(value_data[0], value_data[1]);
+            }
+            break;
     }
 }
 
@@ -815,6 +922,24 @@ void via_config_get_value(uint8_t *data) {
         case id_toggle_socd_indicator:
             *value_data = g_config.show_socd_indicator;
             break;
+        case id_host_key_indicators:
+            value_data[0] = host_indicator_color.r;
+            value_data[1] = host_indicator_color.g;
+            value_data[2] = host_indicator_color.b;
+            value_data[3] = host_indicator_music_playing;
+            break;
+        case id_host_backlight_brightness: {
+            uint8_t actual = rgb_matrix_get_val();
+            if (!host_brightness_transitioning) {
+                host_brightness_target       = actual;
+                host_brightness_last_applied = actual;
+            }
+            value_data[0] = actual;
+            value_data[1] = host_brightness_target;
+            value_data[2] = RGB_MATRIX_MAXIMUM_BRIGHTNESS;
+            value_data[3] = HOST_BRIGHTNESS_PROTOCOL_MARKER;
+            break;
+        }
     }
 }
 

@@ -57,6 +58,73 @@ extern void right_side_side_color_control(uint8_t dir);
 extern void right_side_side_mode_control(uint8_t dir);
 extern void exit_light_sleep(void);
 
+static RGB  host_indicator_color;
+static bool host_indicator_music_playing;
+static bool host_indicator_active;
+
+#define HOST_BRIGHTNESS_PROTOCOL_MARKER 0xB1
+
+static bool     host_brightness_protocol_active;
+static bool     host_brightness_transitioning;
+static uint8_t  host_brightness_start;
+static uint8_t  host_brightness_target;
+static uint8_t  host_brightness_last_applied;
+static uint8_t  host_brightness_duration_ms;
+static uint32_t host_brightness_started_at;
+
+static void host_brightness_set_target(uint8_t target, uint8_t duration_ms) {
+    uint8_t current = rgb_matrix_get_val();
+
+    host_brightness_protocol_active = true;
+    host_brightness_start           = current;
+    host_brightness_target          = target > RGB_MATRIX_MAXIMUM_BRIGHTNESS ? RGB_MATRIX_MAXIMUM_BRIGHTNESS : target;
+    host_brightness_last_applied    = current;
+    host_brightness_duration_ms     = duration_ms;
+    host_brightness_started_at      = timer_read32();
+    host_brightness_transitioning   = current != host_brightness_target && duration_ms > 0;
+
+    if (!host_brightness_transitioning) {
+        rgb_matrix_sethsv_noeeprom(rgb_matrix_get_hue(), rgb_matrix_get_sat(), host_brightness_target);
+        host_brightness_last_applied = rgb_matrix_get_val();
+    }
+}
+
+static void host_brightness_task(void) {
+    if (!host_brightness_protocol_active || !host_brightness_transitioning) {
+        return;
+    }
+
+    uint8_t actual = rgb_matrix_get_val();
+    if (actual != host_brightness_last_applied) {
+        // A physical brightness key always wins over an in-flight host fade.
+        host_brightness_target        = actual;
+        host_brightness_transitioning = false;
+        return;
+    }
+
+    uint32_t elapsed = timer_elapsed32(host_brightness_started_at);
+    uint8_t  value;
+    if (elapsed >= host_brightness_duration_ms) {
+        value = host_brightness_target;
+        host_brightness_transitioning = false;
+    } else if (host_brightness_target >= host_brightness_start) {
+        uint16_t distance = host_brightness_target - host_brightness_start;
+        value             = host_brightness_start + (distance * elapsed) / host_brightness_duration_ms;
+    } else {
+        uint16_t distance = host_brightness_start - host_brightness_target;
+        value             = host_brightness_start - (distance * elapsed) / host_brightness_duration_ms;
+    }
+
+    if (value != actual) {
+        rgb_matrix_sethsv_noeeprom(rgb_matrix_get_hue(), rgb_matrix_get_sat(), value);
+        host_brightness_last_applied = rgb_matrix_get_val();
+    }
+}
+
+bool host_key_indicators_active(void) {
+    return host_indicator_active;
+}
+
 bool pre_process_record_kb(uint16_t keycode, keyrecord_t *record) {
     no_act_time     = 0;

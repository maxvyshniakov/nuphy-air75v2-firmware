+}
+
+static void host_calibrate_rgb(RGB gain, uint8_t *r, uint8_t *g, uint8_t *b) {
+    uint8_t original_peak = MAX(*r, MAX(*g, *b));
+    uint16_t scaled_r = (uint16_t)*r * gain.r;
+    uint16_t scaled_g = (uint16_t)*g * gain.g;
+    uint16_t scaled_b = (uint16_t)*b * gain.b;
+    uint16_t calibrated_peak = MAX(scaled_r, MAX(scaled_g, scaled_b));
+
+    if (calibrated_peak == 0) {
+        *r = 0;
+        *g = 0;
+        *b = 0;
+        return;
+    }
+
+    // Treat the triplet as chromatic balance, not three independent dimmers.
+    // Preserve the source pixel's value so saturated colors remain vivid and
+    // the corrected result can never clip above the original peak channel.
+    *r = ((uint32_t)scaled_r * original_peak + calibrated_peak / 2) / calibrated_peak;
+    *g = ((uint32_t)scaled_g * original_peak + calibrated_peak / 2) / calibrated_peak;
+    *b = ((uint32_t)scaled_b * original_peak + calibrated_peak / 2) / calibrated_peak;
+}

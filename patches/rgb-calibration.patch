diff --git a/keyboards/nuphy/air75v2/ansi/side_driver.c b/keyboards/nuphy/air75v2/ansi/side_driver.c
index e264163291..5d48cbef33 100644
--- a/keyboards/nuphy/air75v2/ansi/side_driver.c
+++ b/keyboards/nuphy/air75v2/ansi/side_driver.c
@@ -47,6 +47,41 @@
     } while (0)
 
+// The Ryo release was built with an older GCC that expanded the short delay
+// into twelve straight NOPs. Newer GCC leaves a counted loop here, stretching
+// WS2812 pulses until the side strip rejects every frame. Keep the waveform
+// independent of compiler loop-unrolling decisions.
+#define SIDE_NOPS_1  "nop\n\t"
+#define SIDE_NOPS_2  SIDE_NOPS_1 SIDE_NOPS_1
+#define SIDE_NOPS_4  SIDE_NOPS_2 SIDE_NOPS_2
+#define SIDE_NOPS_8  SIDE_NOPS_4 SIDE_NOPS_4
+#define SIDE_NOPS_16 SIDE_NOPS_8 SIDE_NOPS_8
+#define SIDE_NOPS_32 SIDE_NOPS_16 SIDE_NOPS_16
+
+static inline void side_wait_one_high(void) {
+    __asm__ volatile(
+        SIDE_NOPS_16 SIDE_NOPS_8 SIDE_NOPS_4 SIDE_NOPS_2
+        ::: "memory"
+    );
+}
+
+static inline void side_wait_short(void) {
+    __asm__ volatile(
+        SIDE_NOPS_8 SIDE_NOPS_4 SIDE_NOPS_2 SIDE_NOPS_1
+        ::: "memory"
+    );
+}
+
+static inline void side_wait_zero_low(void) {
+    __asm__ volatile(SIDE_NOPS_32 SIDE_NOPS_2 ::: "memory");
+}
+
 void side_send_byte(uint8_t byte)
 {
     // WS2812 protocol wants most significant bits first
@@ -57,17 +92,17 @@ void side_send_byte(uint8_t byte)
         if (is_one) {
             // 1
             writePinHigh(DRIVER_SIDE_PIN);
-            wait_ns(WS2812_T1H);
+            side_wait_one_high();
             writePinLow(DRIVER_SIDE_PIN);
-            wait_ns(WS2812_T1L);
+            side_wait_short();
         } else {
             // 0
             writePinHigh(DRIVER_SIDE_PIN);
-            wait_ns(WS2812_T0H);
+            side_wait_short();
             writePinLow(DRIVER_SIDE_PIN);
-            wait_ns(WS2812_T0L);
+            side_wait_zero_low();
         }
     }
 }

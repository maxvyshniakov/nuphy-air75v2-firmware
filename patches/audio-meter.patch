+static RGB host_audio_meter_overlay_color(uint8_t brightness) {
+    RGB color;
+    host_audio_meter_color(&color);
+    uint16_t scale = side_light_table[brightness] + 1;
+    color.r = ((uint16_t)color.r * scale) >> 8;
+    color.g = ((uint16_t)color.g * scale) >> 8;
+    color.b = ((uint16_t)color.b * scale) >> 8;
+    host_side_calibrate_rgb(&color.r, &color.g, &color.b);
+    color.r >>= 2;
+    color.g >>= 2;
+    color.b >>= 2;
+    return color;
+}
+
+static uint8_t host_audio_meter_blend(
+    uint8_t background,
+    uint8_t white,
+    uint8_t intensity
+) {
+    return ((uint16_t)background * (255 - intensity)
+        + (uint16_t)white * intensity + 127) / 255;
+}
+
+static void host_audio_meter_bar(
+    const uint8_t *indices,
+    uint8_t level,
+    RGB color,
+    bool reverse
+) {
+    uint16_t scaled = (uint16_t)level * SIDE_LINE;
+    uint8_t full = scaled / 255;
+    uint8_t partial = scaled % 255;
+    for (uint8_t segment = 0; segment < SIDE_LINE; segment++) {
+        uint8_t intensity = segment < full
+            ? 255
+            : (segment == full ? partial : 0);
+        if (intensity > 0) {
+            uint8_t index = indices[
+                reverse ? SIDE_LINE - 1 - segment : segment
+            ];
+            RGB background = side_leds[index];
+            side_rgb_set_color(
+                index,
+                host_audio_meter_blend(background.r, color.r, intensity),
+                host_audio_meter_blend(background.g, color.g, intensity),
+                host_audio_meter_blend(background.b, color.b, intensity)
+            );
+        }
+    }
+}
+
+static void host_audio_meter_peak(
+    const uint8_t *indices,
+    uint8_t level,
+    RGB color,
+    bool reverse
+) {
+    if (level == 0) return;
+    uint8_t segment = MIN(
+        SIDE_LINE - 1,
+        ((uint16_t)level * SIDE_LINE) / 256
+    );
+    uint8_t index = indices[
+        reverse ? SIDE_LINE - 1 - segment : segment
+    ];
+    side_rgb_set_color(index, color.r, color.g, color.b);
+}
+
+static void host_audio_meter_show(void) {
+    static uint8_t displayed_left;
+    static uint8_t displayed_right;
+    static uint8_t peak_left;
+    static uint8_t peak_right;
+    static uint32_t animation_timer;
+    static uint32_t peak_left_held_at;
+    static uint32_t peak_right_held_at;
+    uint8_t target_left;
+    uint8_t target_right;
+    bool active = host_audio_meter_levels(&target_left, &target_right);
+    if (!active) {
+        displayed_left = 0;
+        displayed_right = 0;
+        peak_left = 0;
+        peak_right = 0;
+        return;
+    }
+
+    if (timer_elapsed32(animation_timer) >= 40) {
+        animation_timer = timer_read32();
+        displayed_left = target_left >= displayed_left
+            ? target_left
+            : MAX(target_left, displayed_left > 18 ? displayed_left - 18 : 0);
+        displayed_right = target_right >= displayed_right
+            ? target_right
+            : MAX(target_right, displayed_right > 18 ? displayed_right - 18 : 0);
+        if (target_left >= peak_left) {
+            peak_left = target_left;
+            peak_left_held_at = animation_timer;
+        } else if (timer_elapsed32(peak_left_held_at) >= 160) {
+            peak_left = MAX(target_left, peak_left > 8 ? peak_left - 8 : 0);
+        }
+        if (target_right >= peak_right) {
+            peak_right = target_right;
+            peak_right_held_at = animation_timer;
+        } else if (timer_elapsed32(peak_right_held_at) >= 160) {
+            peak_right = MAX(target_right, peak_right > 8 ? peak_right - 8 : 0);
+        }
+    }
+
+    RGB left_color = host_audio_meter_overlay_color(g_config.side_brightness);
+    RGB right_color = host_audio_meter_overlay_color(g_config.right_side_brightness);
+    uint8_t mode = host_audio_meter_mode();
+    if (mode != 1) {
+        host_audio_meter_bar(side_led_index_tab, displayed_left, left_color, false);
+        host_audio_meter_bar(right_side_led_index_tab, displayed_right, right_color, true);
+    }
+    if (mode != 0) {
+        host_audio_meter_peak(side_led_index_tab, peak_left, left_color, false);
+        host_audio_meter_peak(right_side_led_index_tab, peak_right, right_color, true);
+    }
+}
+
